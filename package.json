{
  "name": "kruzhok",
  "version": "1.1.0",
  "description": "Плавающее окно камеры поверх приложений",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/leninblok/floating-camera.git"
  },
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check scripts/prepare-installers.js && node --check scripts/prepare-macos-package.js && node --check scripts/require-macos-release-credentials.js && node --check scripts/verify-universal.js",
    "prepare:installers": "node scripts/prepare-installers.js",
    "dist": "electron-builder --mac",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:mac:x64": "electron-builder --mac --x64",
    "dist:mac:unsigned": "ALLOW_UNSIGNED_MACOS_RELEASE=1 electron-builder --mac --arm64 --config.mac.forceCodeSigning=false --config.mac.notarize=false",
    "dist:mac:unsigned:x64": "ALLOW_UNSIGNED_MACOS_RELEASE=1 electron-builder --mac --x64 --config.mac.forceCodeSigning=false --config.mac.notarize=false",
    "dist:win": "electron-builder --win nsis --x64",
    "predist": "npm run prepare:installers",
    "predist:mac:arm64": "npm run prepare:installers",
    "predist:mac:x64": "npm run prepare:installers",
    "predist:mac:unsigned": "npm run prepare:installers",
    "predist:mac:unsigned:x64": "npm run prepare:installers",
    "predist:win": "npm run prepare:installers",
    "verify:mac": "bash scripts/verify-macos-release.sh",
    "test": "node --test tests/*.test.js",
    "test:smoke": "env -u ELECTRON_RUN_AS_NODE electron tests/electron-smoke.js",
    "dist:mac:universal": "electron-builder --mac dmg --universal",
    "dist:mac:unsigned:universal": "ALLOW_UNSIGNED_MACOS_RELEASE=1 electron-builder --mac dmg --universal --config.mac.forceCodeSigning=false --config.mac.notarize=false",
    "predist:mac:universal": "npm run prepare:installers",
    "predist:mac:unsigned:universal": "npm run prepare:installers",
    "verify:universal": "node scripts/verify-universal.js"
  },
  "build": {
    "appId": "io.github.leninblok.kruzhok",
    "productName": "Кружок",
    "asar": true,
    "beforePack": "scripts/prepare-macos-package.js",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "12.0.0",
      "artifactName": "installers/mac-${arch}/${productName}-${version}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "extendInfo": {
        "NSCameraUsageDescription": "Кружок показывает изображение с выбранной камеры поверх приложений.",
        "NSCameraUseContinuityCameraDeviceType": true
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "installers/windows-${arch}/${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@electron/notarize": "3.1.2",
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  }
}
