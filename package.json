{
  "name": "floating-camera",
  "version": "1.0.0",
  "description": "Floating circular camera window (Electron)",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder -m"
  },
  "build": {
    "appId": "com.example.floatingcamera",
    "mac": {
      "target": "dmg",
      "extendInfo": {
        "NSCameraUseContinuityCameraDeviceType": true
      }
    }
  },
  "devDependencies": {
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3"
  }
}
