# Keep the actual values outside the repository (for example, in your CI secret store).
# APPLE_API_KEY is the base64-encoded contents of the App Store Connect .p8 key.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=

# Optional when the Developer ID Application certificate is not installed in the active keychain.
# CSC_LINK=
# CSC_KEY_PASSWORD=
