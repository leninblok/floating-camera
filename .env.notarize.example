# Store actual values in your CI secret store, never in the repository.
# See https://v2.tauri.app/distribute/sign/macos/
APPLE_SIGNING_IDENTITY=
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=

# App Store Connect API key: APPLE_API_KEY_PATH is the path to the .p8 file.
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=
